# Files not sent to Vercel when deploying with the CLI.
#
# Adding this file stops Vercel falling back to .gitignore, so anything that
# must never be uploaded has to be listed here too — the env files above all.

# Secrets. Real values live in the Vercel dashboard, never in the upload.
.env*
!.env.example

# Not used by the site; 89 MB of the repo's 91 MB.
Shai's_Lab_Tab.zip

# Rebuilt on Vercel's servers, so sending ours is wasted upload.
node_modules
.next
out
build
coverage

# Local noise
.git
.DS_Store
*.pem
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
