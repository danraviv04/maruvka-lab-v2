# Lab Members Area Password
# Copy this file to .env.local and set your own password
NEXT_PUBLIC_LAB_PASSWORD=your_secure_password_here

# News Admin Password
# Used by /admin/news. Do not prefix this with NEXT_PUBLIC.
NEWS_ADMIN_PASSWORD=your_news_admin_password_here

# Optional: commit news edits to GitHub for Vercel/Netlify-style deployments
# NEWS_GITHUB_TOKEN=github_pat_with_contents_write_access
# NEWS_GITHUB_REPO=owner/repo
# NEWS_GITHUB_BRANCH=main
# NEWS_GITHUB_FILE_PATH=content/news.json
