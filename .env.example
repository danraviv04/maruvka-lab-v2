# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit it.

# --- Lab Tools / Members Area ---------------------------------------------
# Password for the protected /lab-tools area.
# Server-side only. Do NOT rename this to NEXT_PUBLIC_LAB_PASSWORD: anything
# prefixed with NEXT_PUBLIC_ is compiled into the browser bundle, and the code
# reads LAB_TOOLS_PASSWORD. Without it the lab-tools area stays locked.
LAB_TOOLS_PASSWORD=your_lab_tools_password_here

# --- News Admin ------------------------------------------------------------
# Password for /admin/news. Do not prefix this with NEXT_PUBLIC either.
NEWS_ADMIN_PASSWORD=your_news_admin_password_here

# --- News storage (recommended: Vercel Blob) -------------------------------
# Create a Blob store in the Vercel dashboard and connect it to the project;
# Vercel injects this automatically, so you do not paste it by hand.
# With it set, news added at /admin/news is live immediately with no redeploy,
# and the admin image picker can upload files straight from your computer.
# Without it (and without the GitHub vars below) news writes FAIL on Vercel,
# because the deployed filesystem is read-only.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- News storage (legacy fallback) ----------------------------------------
# Only used when BLOB_READ_WRITE_TOKEN is absent. Commits news to GitHub,
# so every post triggers a rebuild and takes a minute or two to appear.
# NEWS_GITHUB_TOKEN=github_pat_with_contents_write_access
# NEWS_GITHUB_REPO=owner/repo
# NEWS_GITHUB_BRANCH=main
# NEWS_GITHUB_FILE_PATH=content/news.json

# --- Publications ----------------------------------------------------------
# Google Scholar profile ID scraped for the publications page.
# Defaults to the lab PI's profile when unset.
# SCHOLAR_ID=q8BKwrYAAAAJ

# How long a successful Scholar scrape is cached, in seconds (default 3600).
# Raise this if Google starts rate-limiting the deployment.
# REVALIDATE_SECONDS=7200

# --- Site metadata ---------------------------------------------------------
# Absolute base URL used for canonical links and social previews.
# Defaults to https://maruvkalab.technion.ac.il, so set this to the real
# public domain once DNS points at the new site.
# NEXT_PUBLIC_BASE_URL=https://www.maruvkalab.com
