# Lab Members Area Password
# Copy this file to .env.local and set your own password
NEXT_PUBLIC_LAB_PASSWORD=your_secure_password_here

# News Admin Password
# Used by /admin/news. Do not prefix this with NEXT_PUBLIC.
NEWS_ADMIN_PASSWORD=your_news_admin_password_here

# Recommended news storage: Vercel Blob.
# Create a Blob store in the Vercel dashboard and this is injected automatically.
# With it set, news added at /admin/news is live immediately, with no redeploy,
# and the image picker can upload files straight from your computer.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Legacy fallback: commit news edits to GitHub instead.
# Only used when BLOB_READ_WRITE_TOKEN is absent. Each edit triggers a redeploy.
# NEWS_GITHUB_TOKEN=github_pat_with_contents_write_access
# NEWS_GITHUB_REPO=owner/repo
# NEWS_GITHUB_BRANCH=main
# NEWS_GITHUB_FILE_PATH=content/news.json
